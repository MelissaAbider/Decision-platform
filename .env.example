# Exemple : copier les valeurs dans les variables du shell.
# Le fichier .env n'est pas chargé automatiquement.
ADP_ENV=local
ADP_LOG_LEVEL=INFO
ADP_DATA_DIR=data
ADP_POSTGRES_URL=postgresql+psycopg://adp:adp@localhost:5432/adp

# Utilise par Docker Compose / Airflow.
AIRFLOW_UID=1000
ADP_HOST_DATA_ROOT=/home/melis/ia-decision-platform-data

